# ===========================================
# CONFIGURACION DE VUELOS A MONITOREAR
# ===========================================
# Copia este archivo a flights.yaml y ajusta:
#   cp flights.yaml.example flights.yaml
#
# IMPORTANTE: Nunca subas flights.yaml a GitHub
# ===========================================

flights:
  # Ejemplo 1: Vuelo ida y vuelta
  - origin: BOG           # Codigo IATA origen
    destination: MIA      # Codigo IATA destino
    depart_date: "2026-12-01"
    return_date: "2026-12-15"   # Omitir para solo ida
    adults: 1
    currency: USD
    flexible_days: 5       # +/-5 dias en salida y regreso; 0 desactiva

  # Ejemplo 2: Solo ida
  - origin: BOG
    destination: MAD
    depart_date: "2026-11-15"
    adults: 2
    currency: EUR

  # Ejemplo 3: Comparar aeropuertos alternativos del destino
  # Las alternativas se leen de airports.yaml. Para MIA tambien revisa FLL y PBI.
  - origin: BOG
    destination: MIA
    depart_date: "2026-12-01"
    return_date: "2026-12-15"
    adults: 1
    currency: USD
    check_alternatives: true

  # Ejemplo 4: Comparar otras ciudades del mismo pais, en las mismas fechas
  # El pais se deduce de airports.yaml (bloque countries). Para GDL revisa
  # MEX, CUN, MTY y TIJ con UNA sola busqueda extra por corrida.
  - origin: BOG
    destination: GDL
    depart_date: "2026-10-15"
    return_date: "2026-10-25"
    adults: 1
    currency: COP
    country_alternatives: true
    country_alternatives_max: 4   # Destinos por consulta (1 a 6, default 4)

# Codigos IATA comunes:
# BOG = Bogota       MDE = Medellin     CLO = Cali
# MIA = Miami        JFK = New York     LAX = Los Angeles
# MAD = Madrid       BCN = Barcelona    CDG = Paris
# LIM = Lima         SCL = Santiago     GRU = Sao Paulo
